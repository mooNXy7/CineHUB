<resources>
    <style name="Theme.CineHUBMobile" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#E50914</item>
        <item name="android:navigationBarColor">#050609</item>
        <item name="android:statusBarColor">#050609</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.CineHUBMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050609</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cinehub_official</item>
        <item name="postSplashScreenTheme">@style/Theme.CineHUBMobile</item>
    </style>
</resources>
